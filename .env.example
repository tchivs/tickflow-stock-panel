# ===== Market data: TickFlow is the default provider =====
# 留空则启用 TickFlow Free 模式，仅可获取受限的历史日 K 数据。
TICKFLOW_API_KEY=

# ===== Local stockdb (本机 docker :8000, X-API-Key header-only) =====
# LOCAL_STOCKDB_URL: 容器内可达地址 = 桥接网关 http://172.18.0.1:8000
#   (athenaquant_default 网桥网关 = 宿主侧; stockdb 在独立桥接网, 仅宿主 0.0.0.0:8000 发布)。
#   容器内 127.0.0.1:8000 实测 Connection refused (自身 loopback 无服务) — 勿用 127.0.0.1。
#   备选域名 http://host.docker.internal:8000 需 compose 加 extra_hosts:
#   ["host.docker.internal:host-gateway"] (compose 变更, operator 决策)。
# 部署日追加: printf 'LOCAL_STOCKDB_URL=http://172.18.0.1:8000\n' >> .env
LOCAL_STOCKDB_URL=
# LOCAL_STOCKDB_API_KEY: 值 = stockdb 容器 env STOCKDB_API_KEYS 的成员 (逗号分隔多 key 任一可用)。
# 真实 key 只进 .env (mode 600, git-ignored), 不入 git 不入脚本 — 与 TICKFLOW_API_KEY 同纪律。
# 部署日追加: printf 'LOCAL_STOCKDB_API_KEY=<STOCKDB_API_KEYS 成员>\n' >> .env && chmod 600 .env
LOCAL_STOCKDB_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
# 任意 OpenAI 兼容端点。本机部署当前使用 omp 同款网关:
# https://new.vfing.de/v1 + deepseek-v4-flash(key 取 ~/.codex/auth.json)。
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://new.vfing.de/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker build and ./dev.sh / .\dev.ps1.
# Separated by spaces. Examples: legacy-cpu (older hosts without AVX2/FMA),
# backtest, shadow, forecast. Combine as: legacy-cpu backtest
# Forecast installs inference dependencies only; pinned checkpoints must be
# provisioned separately and are never downloaded at application startup.
BACKEND_EXTRAS=
FORECAST_ENABLED=false
FORECAST_DEVICE=cpu
# Docker default: /app/data/forecast-checkpoints
FORECAST_CHECKPOINT_ROOT=

# ===== Data =====
DATA_DIR=./data
